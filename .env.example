# AgriMind Environment Configuration
# Copy this to .env and fill in your API keys

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Options: "gemini", "openai", "local"  (local = built-in rule-based engine)
LLM_PROVIDER=local

# Google Gemini API Key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ─── Application ──────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
DATABASE_URL=sqlite:///./agrimind.db
SECRET_KEY=agrimind-secret-key-change-in-production
# Public URL of this server (used for building farmer follow-up form links)
APP_BASE_URL=http://localhost:8000

# Twilio SMS (for farmer follow-up notifications)
# Get from https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

# ─── Firebase Authentication ──────────────────────────────────────────────────
# From Firebase Console -> Project Settings -> General -> Web App -> apiKey
FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here
FIREBASE_PROJECT_ID=final-year-project

# ─── Email OTP Configuration (SMTP) ───────────────────────────────────────────
# For sending real OTP emails to farmers (e.g., Gmail App Password or SendGrid)
# If left blank, OTPs will be shown in dev preview logs for rapid local testing
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=your_email@gmail.com

